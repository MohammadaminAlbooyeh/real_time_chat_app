{
  "title": "API Performance",
  "uid": "api-performance",
  "panels": [
    {"title": "Request Rate", "type": "graph", "targets": [{"expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}"}]},
    {"title": "Latency P99", "type": "graph", "targets": [{"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "{{endpoint}}"}]},
    {"title": "Error Rate", "type": "graph", "targets": [{"expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "{{endpoint}}"}]}
  ],
  "schemaVersion": 38
}
